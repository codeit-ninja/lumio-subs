# Postgres
DATABASE_URL=postgres://mirror:mirror@localhost:5433/opensubtitles_mirror

# LavX opensubtitles-scraper (root docker-compose service)
OPENSUBTITLES_SCRAPER_URL=http://127.0.0.1:8000

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=opensubtitles-mirror
# Optional override; default: https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public URL prefix for download_url after store (r2.dev or custom domain)
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Worker
WORKER_RATE_PER_SECOND=10
WORKER_BATCH_SIZE=20
WORKER_MAX_RETRIES=5
WORKER_CONCURRENCY=4
ADMINER_PORT=8088

METADATA_DUMP_URL=https://dl.opensubtitles.org/addons/export/subtitles_all.txt.gz
METADATA_DUMP_PATH=/data/subtitles_all.txt.gz
# METADATA_DUMP_FORCE_DOWNLOAD=true
# IMPORT_METADATA_ON_START=true
