PUBLIC_POCKETBASE_URL=http://127.0.0.1:8093
TMDB_API_KEY=
# LavX opensubtitles-scraper sidecar (see docker-compose.yml)
OPENSUBTITLES_SCRAPER_URL=http://127.0.0.1:8000
SUBDL_API_KEY=
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=changeme

# R2 public URL base (PocketBase Files storage → same bucket)
# Object key: {collectionId}/{recordId}/{fileName}
CLOUDFLARE_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=subrest

# Outbound mail (verification emails via app + better-svelte-email)
SMTP_HOST=smtp.mx.cloudflare.net
SMTP_PORT=465
SMTP_USER=api_token
SMTP_PASSWORD=
SMTP_FROM=SubREST <noreply@your-domain.com>
AUTH_VERIFICATION_SECRET=

# Stripe Billing (Checkout + Customer Portal + webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Production (docker-compose.prod.yml) ---
# APP_IMAGE=ghcr.io/YOUR_USER/subrest:latest
# POCKETBASE_IMAGE=ghcr.io/YOUR_USER/subrest-pocketbase:latest
# PUBLIC_POCKETBASE_URL=http://pocketbase:8090
# OPENSUBTITLES_SCRAPER_URL=http://opensubtitles-scraper:8000
# ORIGIN=https://subs.example.com
# APP_PORT=3000
# PB_PORT=8093
